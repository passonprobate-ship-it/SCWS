{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "daemon/dist",
    "rootDir": ".",
    "declaration": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "typeRoots": ["daemon/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "drizzle-orm": ["daemon/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["daemon/node_modules/drizzle-orm/*"],
      "drizzle-zod": ["daemon/node_modules/drizzle-zod"],
      "zod": ["daemon/node_modules/zod"],
      "esbuild": ["daemon/node_modules/esbuild"]
    }
  },
  "include": ["daemon/**/*.ts", "shared/**/*.ts", "script/**/*.ts"]
}
